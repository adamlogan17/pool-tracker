{
    "display_information": {
        "name": "Pool Tracker App"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": false,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "bot_user": {
            "display_name": "BoltApp",
            "always_online": true
        },
        "slash_commands": [
            {
                "command": "/add-me",
                "description": "Adds the current user to the pool-tacker DB",
                "should_escape": true
            },
            {
                "command": "/delete-me",
                "description": "Makes the current user inactive",
                "should_escape": false
            },
            {
                "command": "/my-stats",
                "description": "Shows the current user's stats",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:history",
                "chat:write",
                "im:history",
                "commands"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.channels",
                "message.im"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": true,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}